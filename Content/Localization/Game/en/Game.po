#: /Game/Desecration/System/StringTable/ST_Item.ST_Item
msgctxt "ST_Item,Idol_Moon"
msgid "달의 우상"
msgstr "Idol of the Moon"

#. Key:	Idol_Moon_Content
#. SourceLocation:	/Game/Desecration/System/StringTable/ST_Item.ST_Item
#: /Game/Desecration/System/StringTable/ST_Item.ST_Item
msgctxt "ST_Item,Idol_Moon_Content"
msgid "달의 화신을 조각한 우상. 우상이 길을 잃은 신도의 앞길을 비춰줄 것이다."
msgstr "An idol carved in the likeness of the Moon's incarnation. It shall illuminate the path of devotees who have lost their way."

#. Key:	Memory_Balrog
